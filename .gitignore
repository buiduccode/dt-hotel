# ============================================================
#  .gitignore – Quản lý Khách Sạn DT
#  Đặt file này vào THƯ MỤC GỐC của project (cùng cấp backend/ và front-end/)
# ============================================================

# ── Node.js dependencies ──────────────────────────────────────
node_modules/
**/node_modules/

# ── Biến môi trường (QUAN TRỌNG – chứa password, secret key) ──
.env
**/.env
.env.local
.env.development
.env.production
.env.*.local
# Chỉ giữ lại file mẫu:
!.env.example
!**/.env.example

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Build / dist output ───────────────────────────────────────
dist/
build/
.next/
out/

# ── Cache ─────────────────────────────────────────────────────
.cache/
.npm/
.eslintcache
.stylelintcache

# ── Hệ điều hành ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.temp
*.bak

# ── Runtime ───────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Coverage / Test ───────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────
*.tgz
*.tar.gz